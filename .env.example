# Docker Compose environment for local development.
# Copy to .env and adjust as needed:  cp .env.example .env

# PostgreSQL
POSTGRES_DB=memecoin
POSTGRES_USER=memecoin
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5433

# Host ports
BACKEND_PORT=8010
FRONTEND_PORT=5180

# Cross-service URLs
VITE_API_URL=http://localhost:8010
CORS_ALLOWED_ORIGINS=http://localhost:5180

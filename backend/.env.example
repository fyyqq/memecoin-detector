APP_NAME="Memecoin Detector"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (service name "postgres" resolves inside the Docker network)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=memecoin
DB_USERNAME=memecoin
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5180

# --- DexScreener (Sprint 1 discovery) -------------------------------------
# Primary live market data source. Base URL must come from env, never hardcoded.
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_TIMEOUT=8
DEXSCREENER_CONNECT_TIMEOUT=4
DEXSCREENER_RETRIES=2

# Curated, non-exhaustive memecoin search terms for the discovery sweep.
MEMECOIN_SEARCH_TERMS=pepe,doge,cat,dog,wif,inu,meme,shib,bonk,elon

# Sprint 1 eligibility: age <= MAX_AGE_DAYS and observed peak MC >= OBSERVED_PEAK_MIN_USD.
# "Observed peak" = highest market cap captured by our own snapshots (not a lifetime high).
MEMECOIN_OBSERVED_PEAK_MIN_USD=5000000
MEMECOIN_MAX_AGE_DAYS=30

# Scheduled ingestion cadence for `memecoins:discover` (minutes, 1..60).
MEMECOIN_DISCOVERY_INTERVAL_MINUTES=10

APP_NAME="Memecoin Detector"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (service name "postgres" resolves inside the Docker network)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=memecoin
DB_USERNAME=memecoin
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5180

# --- DexScreener (Sprint 1 discovery) -------------------------------------
# Primary live market data source. Base URL must come from env, never hardcoded.
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_TIMEOUT=8
DEXSCREENER_CONNECT_TIMEOUT=4
DEXSCREENER_RETRIES=2

# --- Discovery sources (Step 19 — trending-meta-first) -----------------
# PRIMARY: DexScreener's documented Trending Meta API (/metas/trending/v1 ->
# /metas/meta/v1/{slug}). The real per-pair Trending table (io.dexscreener.com
# WebSocket) is undocumented + Cloudflare-walled and is NOT used.
DEXSCREENER_TRENDING_META_ENABLED=true
# How many /metas/trending/v1 entries to expand (~18 observed; do not assume forever).
DEXSCREENER_TRENDING_META_LIMIT=18
# Secondary activity signals (kept on; never out-priority trending meta).
DEXSCREENER_PROFILES_ENABLED=true
DEXSCREENER_BOOSTS_ENABLED=true
# Keyword search is a SUPPLEMENTAL long-tail fallback, OFF by default.
MEMECOIN_KEYWORD_DISCOVERY_ENABLED=false

# --- Discovery coverage (Step 14) — keyword fallback only --------------
# Category A — core meme search terms (only consulted when keyword discovery is on).
MEMECOIN_SEARCH_TERMS=pepe,doge,cat,dog,frog,wif,inu,meme,shib,bonk,elon,ai,trump,politics,animal
# Category C — ecosystem names as SUPPLEMENTARY search signals only. DexScreener
# search is global; these are NOT chain filters.
MEMECOIN_ECOSYSTEM_TERMS=solana,base,ethereum,bsc,arbitrum
# Total search terms per run after core + trending-meta + ecosystem merge/dedupe.
MEMECOIN_SEARCH_TERM_BUDGET=25
# How many trending-meta entries (slug + name each) the fallback term engine considers.
DEXSCREENER_TRENDING_META_TERMS=8
# Hard ceiling on the unique candidate set kept per run (before enrichment).
MEMECOIN_DISCOVERY_CANDIDATE_CAP=500
# Hard ceiling on /token-pairs/v1 enrichment calls per run.
MEMECOIN_MAX_ENRICH=120

# Sprint 1 eligibility: age <= MAX_AGE_DAYS AND $5M <= qualifying peak MC <= $1B.
# The lower bound is a PEAK rule — a token whose current MC dumped below $5M
# stays qualified if it already cleared the floor. A token that ever peaked
# above the ceiling is excluded even if its current MC is far lower.
MEMECOIN_OBSERVED_PEAK_MIN_USD=5000000
MEMECOIN_OBSERVED_PEAK_MAX_USD=1000000000
MEMECOIN_MAX_AGE_DAYS=30
# Loose pre-enrichment age gate for trending-meta pairs (PERFORMANCE only;
# final age always uses earliest_pair_created_at across ALL pairs).
MEMECOIN_PREFILTER_MAX_AGE_DAYS=35

# Scheduled ingestion cadence for `memecoins:discover` (minutes, 1..60).
MEMECOIN_DISCOVERY_INTERVAL_MINUTES=10

# --- Recently Crossed $5M (Step 20) -------------------------------------
# GET /api/memecoins per-row `recently_crossed` flag window (hours). Unchanged.
MEMECOIN_RECENT_CROSSING_HOURS=48
MEMECOIN_RECENT_CROSSING_MAX_HOURS=168

# "🔥 Recently Crossed $5M" dashboard section (GET /api/memecoins/recently-crossed).
# Crossing window (days) + the deterministic quality gates (all PostgreSQL-only).
MEMECOIN_RECENT_CROSSING_WINDOW_DAYS=30
# The discovery pipeline must have observed the token this recently (its only
# persisted token-level "still trending / discovered" signal).
MEMECOIN_RECENT_CROSSING_DISCOVERY_FRESHNESS_HOURS=48
# Holder floor: holders / ($current_market_cap / 1e6). A hard reject for obvious
# anomalies ($50M MC / 20 holders = 0.4). require_holder_evidence: a MEASURED
# holder_count risk signal is required; UNKNOWN => reject.
MEMECOIN_RECENT_CROSSING_MIN_HOLDERS_PER_MILLION_MCAP=5.0
MEMECOIN_RECENT_CROSSING_REQUIRE_HOLDER_EVIDENCE=true
# 24h volume must be at least this fraction of CURRENT market cap ($50M MC /
# $7.2K volume = 0.000144 => rejected). Never FDV, never peak MC.
MEMECOIN_RECENT_CROSSING_MIN_VOLUME_TO_MCAP_RATIO=0.001
# Relative liquidity floor, on top of MEMECOIN_RISK_MIN_LIQUIDITY_USD.
MEMECOIN_RECENT_CROSSING_MIN_LIQUIDITY_TO_MCAP_RATIO=0.001

# --- Historical peak qualification (Step 13C, Strategy D) ----------------
# Runs after age filter. Recovers tokens that crossed the threshold BEFORE our
# detector saw them, using tiered evidence:
#   CURRENT_OBSERVATION  our own snapshot saw market_cap >= threshold
#   HISTORICAL_VERIFIED  CoinGecko non-zero historical market cap point
#   HISTORICAL_ESTIMATE  GeckoTerminal peak price x immutable total supply (FDV basis)
#   UNKNOWN              no safe evidence (NOT "never reached the threshold")
HISTORICAL_MIN_PEAK_USD=5000000
HISTORICAL_LOOKUP_COOLDOWN_HOURS=6
HISTORICAL_MAX_LOOKUPS_PER_RUN=15
# Allow an FDV-basis estimate on chains with no mint-authority signal (most EVM
# chains) at LOW confidence. Default false = conservative (no signal -> UNKNOWN).
HISTORICAL_ESTIMATE_ALLOW_UNVERIFIED_SUPPLY=false

# CoinGecko — optional, resilient. Any failure falls through to GeckoTerminal.
# Never expose the key to React.
COINGECKO_ENABLED=true
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
COINGECKO_CACHE_TTL=21600
COINGECKO_MAX_CALLS_PER_RUN=20

# GeckoTerminal — free, no key. Historical price only; the market cap is
# reconstructed (FDV basis) and gated by a supply-safety check.
GECKOTERMINAL_ENABLED=true
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_CACHE_TTL=21600
GECKOTERMINAL_MAX_CALLS_PER_RUN=45

# --- Pump event detection (Step 16A) — heuristic MVP thresholds -----------
# Detects "observed pumps" over the ~10-min snapshot series. WHEN, not why.
# These defaults are conservative starting points, not scientifically optimal.
PUMP_MIN_MARKET_CAP_CHANGE_PCT=50
PUMP_MIN_PRICE_CHANGE_PCT=40
PUMP_MIN_VOLUME_CHANGE_RATIO=2.0          # rolling 24h ratio, NOT interval volume
PUMP_MIN_TRANSACTION_CHANGE_RATIO=2.0     # rolling 24h ratio, NOT interval txns
PUMP_MIN_CONFIRMATION_SIGNALS=2
PUMP_PRIMARY_WINDOW_MINUTES=60
PUMP_ACCELERATION_WINDOW_MINUTES=25
PUMP_WINDOW_TOLERANCE_MINUTES=20
PUMP_EVENT_MERGE_WINDOW_MINUTES=60
PUMP_EVENT_STALE_AFTER_MINUTES=90
PUMP_RECENT_SNAPSHOTS_PER_TOKEN=24
PUMP_MINIMUM_SNAPSHOTS=3

# --- Evidence collection (Step 16B) --------------------------------------
# Collects timestamped FACTS around detected pump events. It never claims
# causality from temporal correlation — AI explanation is Step 16C.
EVIDENCE_WINDOW_BEFORE_MINUTES=60         # investigation_start = started_at - this
EVIDENCE_WINDOW_AFTER_MINUTES=30          # investigation_end   = peak_at   + this
EVIDENCE_COLLECTION_COOLDOWN_HOURS=2      # don't re-investigate an event faster than this
EVIDENCE_RECENT_EVENT_HOURS=48           # only investigate events peaking within this window
EVIDENCE_MAX_EVENTS_PER_RUN=20

# RELATED_TOKEN collector — PostgreSQL only, no HTTP.
EVIDENCE_RELATED_LEAD_WINDOW_MINUTES=60
EVIDENCE_RELATED_MIN_MOVE_PCT=40
EVIDENCE_RELATED_MAX=5
EVIDENCE_RELATED_CROSS_CHAIN=false

# NEWS collector — the ONLY external call. GDELT 2.1 DOC API (free, no key).
# Any provider failure is logged and skipped; it never fails the command.
EVIDENCE_NEWS_ENABLED=true
EVIDENCE_NEWS_PROVIDER=gdelt              # gdelt | none
EVIDENCE_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
EVIDENCE_NEWS_TIMEOUT=8
EVIDENCE_NEWS_CONNECT_TIMEOUT=4
EVIDENCE_NEWS_MAX_REQUESTS_PER_RUN=15
EVIDENCE_NEWS_MAX_RESULTS_PER_EVENT=10
EVIDENCE_NEWS_MIN_SYMBOL_LENGTH=4
EVIDENCE_NEWS_TRUSTED_DOMAINS=coindesk.com,cointelegraph.com,theblock.co,decrypt.co,blockworks.co,dlnews.com,cryptoslate.com,beincrypto.com,bitcoinmagazine.com

# --- AI pump explanation (Step 16C) -------------------------------------
# The LLM INTERPRETS stored Evidence — it never adds facts, never browses,
# never treats correlation as causation. Every claim cites evidence ids.
# The read API NEVER calls the provider; generation is CLI/scheduler only.
AI_PROVIDER=anthropic                     # anthropic | null (null = never call out, always fail)
AI_MODEL=claude-sonnet-5
AI_TIMEOUT=45
AI_CONNECT_TIMEOUT=10
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.0                        # interpretation should be stable, not creative

# Anthropic provider — server-side only, never exposed to React.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

PUMP_EXPLANATION_RECENT_EVENT_HOURS=48    # only explain events peaking within this window
PUMP_EXPLANATION_COOLDOWN_HOURS=6         # don't regenerate a completed explanation faster than this
PUMP_EXPLANATION_MAX_EVENTS_PER_RUN=15    # hard ceiling on AI calls per run
PUMP_EXPLANATION_MAX_EVIDENCE=20          # only the highest-relevance evidence records are sent

# --- Token Narrative Intelligence (Step 21) -----------------------------
# "Why was this coin created?" + "Why did it become popular?" — token-level,
# evidence-grounded AI synthesis, SEPARATE from the pump explanation. The AI is
# an interpreter only: it never browses, never invents sources / URLs / dates,
# and every factual claim cites a token_narrative_sources id.
NARRATIVE_RESEARCH_PROVIDERS=internal,gdelt   # ordered; `internal` is the always-on baseline
NARRATIVE_GDELT_ENABLED=true                  # token-level GDELT news search (degrades to none on failure)
NARRATIVE_GDELT_LOOKBACK_DAYS=120
NARRATIVE_GDELT_MAX_REQUESTS_PER_RUN=20
NARRATIVE_AI_PROVIDER=anthropic               # anthropic | null — separate binding from AI_PROVIDER
NARRATIVE_AI_MODEL=claude-sonnet-5
NARRATIVE_AI_MAX_TOKENS=3000
TOKEN_NARRATIVE_RESEARCH_COOLDOWN_HOURS=24    # don't re-research a token faster than this
TOKEN_NARRATIVE_MAX_TOKENS_PER_RUN=10         # start conservative
NARRATIVE_PROVIDER_CACHE_HOURS=6              # web research response cache
NARRATIVE_MAX_SOURCES_PER_SECTION=12         # sources kept (after ranking) per section
# NARRATIVE_TRUSTED_DOMAINS / NARRATIVE_REFERENCE_DOMAINS default to a curated list (see config/narrative.php)

# --- Memecoin Risk & Safety Screening (Step 24) ------------------------
# A conservative risk screen LAYERED ON TOP OF the market-cap qualification.
# It never changes qualification / observed_peak_market_cap / pump events /
# evidence. This is a RISK FILTER, NOT a "safe to invest" guarantee — the
# product never says "safe", "guaranteed" or "scam probability". Scoring is
# deterministic; no AI. Read APIs never call a security provider.
MEMECOIN_MAIN_MIN_AGE_HOURS=72                    # tokens younger than this cannot enter the MAIN LIST (still shown on Risk Watch)
MEMECOIN_RISK_MAIN_LIST_REQUIRE_SCREENING=true    # a MAIN LIST token must have a completed LOWER/MEDIUM assessment
MEMECOIN_RISK_MIN_DATA_COMPLETENESS=0.50          # below this => risk_level = UNKNOWN (distinct from HIGH) => Risk Watch

# 0-100 heuristic risk score (higher = more risk — NOT a probability of scam/rug/loss).
# Dimension weights sum to 1.0.
MEMECOIN_RISK_W_CONTRACT=0.30
MEMECOIN_RISK_W_EXIT_SAFETY=0.15
MEMECOIN_RISK_W_HOLDERS=0.18
MEMECOIN_RISK_W_LIQUIDITY=0.12
MEMECOIN_RISK_W_PUMP_DUMP=0.12
MEMECOIN_RISK_W_MARKET_STRUCTURE=0.08
MEMECOIN_RISK_W_AGE=0.05
MEMECOIN_RISK_LEVEL_MEDIUM_AT=25                  # score band edges: <25 LOWER, <50 MEDIUM, <75 HIGH, else CRITICAL
MEMECOIN_RISK_LEVEL_HIGH_AT=50
MEMECOIN_RISK_LEVEL_CRITICAL_AT=75

# Hard filters (a single measured signal forces the level regardless of score).
MEMECOIN_RISK_SELL_TAX_CRITICAL_AT=1.0            # sell tax >= this fraction (1.0 = 100%) => CRITICAL
MEMECOIN_RISK_TAX_HIGH_AT=0.10                    # buy/sell tax >= this => HIGH
MEMECOIN_RISK_MINTABLE_LEVEL=HIGH                 # is_mintable == true (explicit) => at least this level; UNKNOWN mint is NOT claimed present
MEMECOIN_RISK_TOP1_CRITICAL_AT=0.50              # effective top-1 holder share (LP/burn/CEX excluded)
MEMECOIN_RISK_TOP1_HIGH_AT=0.35
MEMECOIN_RISK_CREATOR_HIGH_AT=0.20
MEMECOIN_RISK_MIN_LIQUIDITY_USD=10000            # below this = no usable liquidity (hard fail)
MEMECOIN_RISK_LP_LOCKED_SAFE_AT=0.50            # LP locked/burned fraction that counts as LP-safety evidence
MEMECOIN_RISK_CRASH_DRAWDOWN_AT=0.70           # round trip + this drawdown + volume collapse = hard pump-dump fail

# Run controls — screening is externally dependent, so it caps tokens/run and
# never rescans inside the cooldown.
MEMECOIN_RISK_SCAN_COOLDOWN_HOURS=6
MEMECOIN_RISK_MAX_TOKENS_PER_RUN=15

# GoPlus Security API — PRIMARY provider. Free, no key required (an optional App
# Key raises limits). Server-side only — never exposed to React.
MEMECOIN_RISK_GOPLUS_ENABLED=true
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1
GOPLUS_APP_KEY=
GOPLUS_MAX_CALLS_PER_RUN=60
# GeckoTerminal /info — SECONDARY verification (holder buckets, Solana authorities, honeypot).
MEMECOIN_RISK_GT_INFO_ENABLED=true
MEMECOIN_RISK_GT_MAX_CALLS_PER_RUN=30
# DexScreener /token-pairs/v1 — reused for liquidity structure (pool/DEX spread).
MEMECOIN_RISK_DEXSCREENER_PAIRS_ENABLED=true
MEMECOIN_RISK_DEXSCREENER_MAX_CALLS_PER_RUN=40
